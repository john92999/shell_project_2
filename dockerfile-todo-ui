# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:14-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm install --legacy-peer-deps --silent

COPY . .

# Fix antd@3.x + @types/react@17 conflict — must be a single line
RUN node -e "const fs=require('fs');['tsconfig.json','tsconfig.prod.json'].forEach(f=>{const c=JSON.parse(fs.readFileSync(f));c.compilerOptions.skipLibCheck=true;fs.writeFileSync(f,JSON.stringify(c,null,2))})"

RUN npm run build

# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
FROM nginx:stable-alpine

COPY --from=build /app/build /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

WORKDIR /usr/share/nginx/html
COPY env.sh .
COPY .env .
RUN chmod +x env.sh

CMD ["/bin/sh", "-c", "/usr/share/nginx/html/env.sh && nginx -g 'daemon off;'"]