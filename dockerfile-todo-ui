# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:14-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm install --legacy-peer-deps --silent

COPY . .

# Inject skipLibCheck into both tsconfig files to fix antd@3.x + @types/react@17 conflict
# antd 3.x bundles its own @types/react inside react-slick which clashes with project's @types/react
RUN node -e "
  const fs = require('fs');
  ['tsconfig.json','tsconfig.prod.json'].forEach(f => {
    const cfg = JSON.parse(fs.readFileSync(f));
    cfg.compilerOptions.skipLibCheck = true;
    fs.writeFileSync(f, JSON.stringify(cfg, null, 2));
  });
"

RUN npm run build

# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
FROM nginx:stable-alpine

COPY --from=build /app/build /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

WORKDIR /usr/share/nginx/html
COPY env.sh .
COPY .env .
RUN chmod +x env.sh

CMD ["/bin/sh", "-c", "/usr/share/nginx/html/env.sh && nginx -g 'daemon off;'"]