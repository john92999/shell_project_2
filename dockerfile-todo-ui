# ── Stage 1: Build ────────────────────────────────────────────────────────────
# node:14-alpine matches react-scripts-ts@3.1.0 (very old package, needs older Node)
FROM node:14-alpine AS build

WORKDIR /app

COPY package*.json ./

# --legacy-peer-deps bypasses the peer dependency conflicts in old packages
RUN npm install --legacy-peer-deps --silent

COPY . .

RUN npm run build

# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
FROM nginx:stable-alpine

# react-scripts-ts builds to /build, NOT /dist (that's Vite)
COPY --from=build /app/build /usr/share/nginx/html

COPY nginx.conf /etc/nginx/conf.d/default.conf

WORKDIR /usr/share/nginx/html
COPY env.sh .
COPY .env .

RUN chmod +x env.sh

CMD ["/bin/sh", "-c", "/usr/share/nginx/html/env.sh && nginx -g 'daemon off;'"]